{
  "name": "reliquary",
  "version": "0.4.0",
  "private": true,
  "description": "Desktop studio for Rainbow Six Siege assets: operators, weapons, skins and retired seasons, straight into Blender.",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build:ooz": "engine\\native\\ooz\\build.bat",
    "build:engine": "npm run build:ooz && python -m PyInstaller --noconfirm --distpath engine-dist --workpath build/engine engine/reliquary-engine.spec",
    "dist": "npm run build:engine && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fialsss/Reliquary.git"
  },
  "homepage": "https://github.com/Fialsss/Reliquary",
  "productName": "Reliquary",
  "author": "Fialsss",
  "build": {
    "appId": "io.github.fialsss.reliquary",
    "productName": "Reliquary",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine-dist/reliquary-engine",
        "to": "engine"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Reliquary-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Reliquary-${version}-portable.exe"
    }
  }
}
